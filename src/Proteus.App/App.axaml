<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Proteus.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Proteus/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#6D4AFF" />
        <ColorPaletteResources x:Key="Dark" Accent="#7C5CFF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Proteus/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
